<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Project 2: Serverless Image Processing Pipeline (S3, SQS, Lambda) - Region: us-east-1" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="900" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="region" value="AWS Cloud - us-east-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="70" width="1030" height="700" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="User / Client&lt;br&gt;(browser or CloudShell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="viewer" value="Viewer&lt;br&gt;(browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1230" y="300" width="100" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="api" value="API Gateway (HTTP API)&lt;br&gt;GET /upload-url, throttled 5/10&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="210" y="130" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="presign" value="Lambda: image-pipeline-presign&lt;br&gt;creates pre-signed PUT URL (300 s)&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="190" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="src" value="S3 Source bucket&lt;br&gt;image-pipeline-moiz-source-0001&lt;br&gt;private, prefix uploads/&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="190" y="290" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="sqs" value="SQS: image-pipeline-queue&lt;br&gt;visibility 180 s, retention 4 d&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="290" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lam" value="Lambda: image-pipeline-processor&lt;br&gt;Python 3.12 + Pillow layer&lt;br&gt;resize 800 px + watermark&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="290" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dst" value="S3 Destination bucket&lt;br&gt;image-pipeline-moiz-dest-0001&lt;br&gt;private, prefix processed/&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="850" y="290" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cf" value="CloudFront (OAC)&lt;br&gt;HTTPS only, GET/HEAD&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1050" y="290" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="dlq" value="SQS DLQ: image-pipeline-dlq&lt;br&gt;retention 14 d&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="410" y="470" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ddb" value="DynamoDB&lt;br&gt;image-pipeline-metadata&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="630" y="470" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sns" value="SNS: image-pipeline-notification&lt;br&gt;&lt;b&gt;[Tested]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="470" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="email" value="Email subscriber&lt;br&gt;(SUCCESS / FAILURE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="815" y="590" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="sf" value="Step Functions: image-pipeline-workflow&lt;br&gt;Validate, Process, Notify&lt;br&gt;started manually only&lt;br&gt;&lt;b&gt;[Partially implemented]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="470" width="190" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="planned" value="&lt;b&gt;[Planned]&lt;/b&gt;&lt;br&gt;- Authentication for the upload API (API key or authorizer)&lt;br&gt;- CloudFront signed URLs or cookies&lt;br&gt;- Connect Step Functions to the live upload path&lt;br&gt;- Report batch item failures for SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="600" width="400" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Green = Tested&lt;br&gt;Orange dashed = Partially implemented&lt;br&gt;Grey dashed = Planned&lt;br&gt;Lifecycle rules on both buckets:&lt;br&gt;Implemented, not proven by a test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="590" width="200" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="1. GET /upload-url" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="client" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="invoke" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="api" target="presign">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="2. returns pre-signed URL" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="presign" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="525" y="55"/>
              <mxPoint x="90" y="55"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="3. PUT image (pre-signed URL)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="client" target="src">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="4. S3 event notification" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="src" target="sqs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="5. event source mapping&lt;br&gt;(batch size 1)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="sqs" target="lam">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="6. write processed/{source key}" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="lam" target="dst">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="after 3 failed receives" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;" edge="1" parent="1" source="sqs" target="dlq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="7. save metadata" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="lam" target="ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="8. publish SUCCESS / FAILURE" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="lam" target="sns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="email" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="sns" target="email">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="9. HTTPS GET /uploads/file.jpg" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="viewer" target="cf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="250"/>
              <mxPoint x="1120" y="250"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="origin path /processed (OAC)" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="cf" target="dst">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="400"/>
              <mxPoint x="940" y="400"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e14" value="manual start: invoke" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="sf" target="lam">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1095" y="430"/>
              <mxPoint x="720" y="430"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" value="on failure: publish" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="sf" target="sns">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
